root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{*.sln,*.vcxproj,*.vcxproj.filters}]
end_of_line = crlf
indent_size = 2

[legacy/**]
# kept byte-for-byte as received; do not reformat
trim_trailing_whitespace = false
insert_final_newline = false
